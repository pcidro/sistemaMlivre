NODE_ENV=development
PORT=3333

DATABASE_URL=
FRONTEND_URL=http://localhost:5173
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REDIRECT_URI=
# Primeira sincronizacao apos OAuth: inteiro de 1 a 365. Padrao: 90 dias.
MERCADO_LIVRE_INITIAL_SYNC_DAYS=90

MAGALU_CLIENT_ID=
MAGALU_CLIENT_SECRET=
# Deve ser igual ao redirect cadastrado no ID Magalu (incluindo /api).
# Proxy /api atual: https://mlivrefrontend.onrender.com/api/marketplace-accounts/magalu/callback
# Connect e callback devem usar o mesmo dominio visto pelo navegador.
MAGALU_REDIRECT_URI=
# Ambiente explicito; sandbox e o padrao quando a variavel estiver ausente.
MAGALU_ENV=sandbox
# Opcional: se preenchida, deve corresponder a MAGALU_ENV.
# production usa https://api.magalu.com
MAGALU_API_URL=https://api-sandbox.magalu.com
MAGALU_AUTH_URL=https://id.magalu.com
